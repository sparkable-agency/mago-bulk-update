{
    "name": "sparkable/magento-mago-bulk-update",
    "description": "Mago Assistant tool that sets attribute values on many products and adds attribute options",
    "type": "magento2-module",
    "license": "MIT",
    "homepage": "https://github.com/sparkable-agency/mago-bulk-update",
    "require": {
        "php": "^8.3",
        "mago-assistant/magento2-mago": "^1.1",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-eav": "*",
        "sparkable/magento-mago-product-finder": "^1.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Sparkable\\MagoBulkUpdate\\": ""
        }
    },
    "config": {
        "sort-packages": true
    }
}
